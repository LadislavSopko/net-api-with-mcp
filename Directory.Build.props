<Project>
  <Import Project="Version.props" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TargetFramework>$(BuildFor)</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Ladislav Sopko</Authors>
    <Company>0ics srl</Company>
    <PackageProjectUrl>https://github.com/LadislavSopko/net-api-with-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LadislavSopko/net-api-with-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyVersion>$(MainVersion).$([System.DateTime]::Now.ToString("yy"))$([System.DateTime]::Now.DayOfYear.ToString("000"))</AssemblyVersion>
    <FileVersion>$(MainVersion).$([System.DateTime]::Now.ToString("yy"))$([System.DateTime]::Now.DayOfYear.ToString("000"))</FileVersion>
    <Version>$(MainVersion)</Version>
    <PackageVersion>$(MainVersion)</PackageVersion>
    <Copyright>Copyright © Ladislav Sopko / 0ics srl 2025</Copyright>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- SourceLink for debugging NuGet packages -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Layer-1 native lint gate (Roslyn analyzers), added by j-setup -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- TODO(lint-debt): set to true once the ~36 analyzer findings in Zero.Mcp.Extensions are fixed (CA1848, CA2007, CA1873, CA1310, IDE0005, CA2263, CA1860). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- TEMP: NuGet audit warnings (known vulns in Microsoft.OpenApi 2.0.0 / SourceLink 10.0.102) stay warnings until the dependency bump lands. Remove this line afterwards. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
