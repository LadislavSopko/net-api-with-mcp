<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet metadata (inherits from Directory.Build.props) -->
    <PackageId>Zero.Mcp.Extensions</PackageId>
    <Description>Turns ASP.NET Core API controllers into MCP (Model Context Protocol) server tools using the official MCP C# SDK attributes, with ActionResult&lt;T&gt; unwrapping. Authorization follows your controllers: [Authorize], policies and [AllowAnonymous] are enforced by the SDK authorization filters for tools/list and tools/call.</Description>
    <PackageTags>mcp;model-context-protocol;aspnetcore;api;authorization;authentication;ai;llm;tools</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v3.0.1 (security fix, drop-in for 3.0.0): a tool method inherited from a base controller now carries the class-level [Authorize] of the SCANNED controller, closing an authorization bypass where the derived policy was dropped and tools/list + tools/call enforced only the weaker base policy (GitHub issue #1). No API change. See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zero.Mcp.Extensions.Tests" />
  </ItemGroup>
</Project>
