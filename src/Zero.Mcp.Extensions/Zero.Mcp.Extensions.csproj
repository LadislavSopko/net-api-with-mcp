<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet metadata (inherits from Directory.Build.props) -->
    <PackageId>Zero.Mcp.Extensions</PackageId>
    <Description>Turns ASP.NET Core API controllers into MCP (Model Context Protocol) server tools using the official MCP C# SDK attributes, with ActionResult&lt;T&gt; unwrapping. Authorization follows your controllers: [Authorize], policies and [AllowAnonymous] are enforced by the SDK authorization filters for tools/list and tools/call.</Description>
    <PackageTags>mcp;model-context-protocol;aspnetcore;api;authorization;authentication;ai;llm;tools</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v3.0.0 (breaking): built on ModelContextProtocol 2.2.0; SDK attributes replace the library's own; custom auth supplier/role resolver removed in favour of SDK AddAuthorizationFilters(); FilterToolsByPermissions removed; new ToolsListTimeToLive cache hints, SessionMode (stateless default), Title/hints/IconSource/UseStructuredContent/OutputSchemaType passthrough. See CHANGELOG.md for migration steps.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zero.Mcp.Extensions.Tests" />
  </ItemGroup>
</Project>
